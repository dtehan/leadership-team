.DS_Store

# Customer account workspaces are local and never committed. Each account holds its own
# company/ knowledge, questions/, decisions/ and memories/ (see scripts/accounts.py).
# The generic skeleton for new accounts lives in company-template/.
accounts/*
!accounts/.gitkeep

# Per-session account locks written by scripts/account_guard.py
.claude/account-locks/

# Built packages (scripts/package.py)
dist/
