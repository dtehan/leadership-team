.DS_Store

# Customer account workspaces are local and never committed. Each account holds its own
# company/ knowledge and named teams/ (see scripts/accounts.py).
# The generic skeleton for new accounts lives in company-template/.
accounts/*
!accounts/.gitkeep

# Local Copilot state and pre-conversion session state.
.copilot/
.copilot-tracking/
__pycache__/
*.pyc



